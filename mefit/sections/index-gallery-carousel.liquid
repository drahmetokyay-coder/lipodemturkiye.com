.full-banner-blocks  .slick-slider .slick-track {transform: translate3d(0, 0, 0) !important;}
  
  .full-banner-block-wrapper {
    display: inline-block;
    width: 100%;
    position: relative;
    align-items: center;
    justify-content: flex-end;
    flex-wrap: wrap;
  }

  .full-banner-blocks.block5 h2, .full-banner-blocks.block5 .h2 { font-size: 90px; margin-top: 45px; }
  
  @media screen and (max-width: 1199px) {
    .full-banner-blocks.block5 h2, .full-banner-blocks.block5 .h2 { font-size: 40px; }
  
    .full-banner-blocks.block2 .full-banner-content { width: 100%; }
    
    .full-banner-blocks .slick-prev,
    .full-banner-blocks .slick-next { display: none !important; }
  }

.block5 .wide--one-half:nth-child(2n+1) {
  clear: both; }

.full-banner-blocks.block2 .full-banner-content {
  width: 70%; }

.block5 .full-banner-blocks .full-banner-content {
  padding: 80px 0 40px 0; }

.block5 .icon-section:hover .icon:before {
  transform: scale(1);
  -moz-transform: scale(1);
  -ms-transform: scale(1); }

.full-banner-block .full-banner-content h6, .full-banner-block .full-banner-content .h6 {
  font-weight: normal;
  font-size: 20px;
  text-transform: uppercase; }

.full-banner-blocks .slick-list { padding: 0px 0; }
  
.full-banner-blocks .parallax-one { padding: 120px 0; background-position: top center; }
  
.full-banner-block .full-banner-content.content-center.left {
  text-align: left;
}

.full-banner-block .full-banner-content.content-center {
  padding-top: 50px;
}

.full-banner-block .full-banner-content.content-center {
  left: 0;
  margin: auto;
  text-align: center;
}
  
  .full-banner-blocks .full-banner-content img { float: right; text-align: right; }
  
  .full-banner-block .full-banner-content.content-center .description-one { font-weight: 600; font-size: 20px; }
  
  
 {% for block in section.blocks %}
  
      .block5 .icon-section .icon.slick-current.icon--{{ block.id }} img { box-shadow: 0 0 0px 5px {{block.settings.img_border_color}}; }
      .block5 .slider-{{ section.id }}-init .icon-section .icon img:hover { box-shadow: 0 0 0px 5px {{block.settings.img_border_color}}; }

  {% endfor %}
  
  .full-banner-content .dt-sc-btn { color:{{ section.settings.button_txt_color }};background-color:{{ section.settings.button_bg_color }}; }
  .full-banner-content .dt-sc-btn:hover { color:{{ section.settings.button_hover_txt_color }};background-color:{{ section.settings.button_hover_bg_color }};
  border-color:{{ section.settings.button_hover_bg_color }}; }

  .full-banner-blocks.block5 .slick-prev:before,.full-banner-blocks.block5 .slick-next:before { color:{{ section.settings.text_color }}; }
  
  @media only screen and (min-width:320px) and (max-width:1199px) {

    .full-banner-blocks.block5 .full-banner-content{background:{{ section.settings.mobile_bg_color | color_modify: 'alpha', 0.8 }}}

  }
  
  
