<div data-section-id="{{ section.id }}" data-section-type="full-banner-blocks" class="full-banner-blocks block5">      

  <div class="parallax-one section section-{{ section.id }}-block " id="section{{section.id }}" style="background-repeat:no-repeat;background-size:cover;background-color:{{section.settings.bg_color}}">  
    <div class="page-width">
      {% if section.settings.title != blank %}
      <h2 style="color:{{ section.settings.title_color }}">{{ section.settings.title }}</h2>
      {% endif %}
      {% if section.blocks.size > 0 %}  


      <div class="full-banner-block-wrapper">
        <div class="full-banner-block slider-slick-init" style="margin:auto;"> 
          {% for block in section.blocks %}
          <div class="full-banner-content full-banner-content--{{ block.id }} content-center {{ section.settings.alignment }}">  
            <div class="dt-sc-column two-column">
              <div class="image-block">
              {% if block.settings.large_img != blank %}            
              <div class="icon">
                <img src="{{ block.settings.large_img | image_url: width: 1000  }}" alt="{{ block.settings.sub_title }}"  style =""/>
              </div>     
              {% else %}
              <div class="icon">
                <img src="https://via.placeholder.com/600x600" />
              </div>          
              {% endif %}
              </div>
              <div class="content-block">
              {% if block.settings.sub_title != blank %}
              <div class="short-desc">
                <h3 style="color:{{ section.settings.sub_title_color }}">{{ block.settings.sub_title }}</h3>
              </div>
              {% endif %}


              {% if block.settings.text != blank %}
              <div style="color:{{ section.settings.text_color }}" class="description-one">{{ block.settings.text }}</div>
              {% endif %}   

              {% if block.settings.button != blank %}
              <a class="dt-sc-btn button button--primary" href="{{ block.settings.link }}" style="">{{ block.settings.button }}</a>
              {% endif %}  
              </div>
            </div>          
          </div>
          {% endfor %}
        </div>       

        <div class="icon-section  slider-slick-nav" style="margin:auto;">   
          {% for block in section.blocks %}
          {% if block.settings.client_img != blank %}          
          <div class="icon icon--{{ block.id }}">
            <img src="{{ block.settings.client_img | image_url: width: 300  }}" alt="{{ block.settings.sub_title }}"  style =""/>
          </div>            
          {% else %}
          <div class="icon">
            <img src="https://via.placeholder.com/64x64" />
          </div>
          {% endif %}         
          {% endfor %}
        </div>         
      </div>
      {% endif %} 
    </div>
  </div>
</div>


  {% if section.settings.image != blank %} 
  <style>    
    
    @media screen and (max-width: 150px) {
      .section-{{ section.id }}-block {
        background-image: url('{{ section.settings.image | image_url: width: 150 }}');
          }
    }

    @media screen and (min-width: 151px) and (max-width: 300px) {
      .section-{{ section.id }}-block {
        background-image: url('{{ section.settings.image | image_url: width: 300 }}');
          }
    }

    @media screen and (min-width: 301px) and (max-width: 600px) {
      .section-{{ section.id }}-block {
        background-image: url('{{ section.settings.image | image_url: width: 600 }}');
          }
    }

    @media screen and (min-width: 601px) and (max-width: 800px) {
      .section-{{ section.id }}-block {
        background-image: url('{{ section.settings.image | image_url: width: 800 }}');
          }
    }

    @media screen and (min-width: 801px) and (max-width: 1000px) {
      .section-{{ section.id }}-block {
        background-image: url('{{ section.settings.image | image_url: width: 1500 }}');
          }
    }

    @media screen and (min-width: 1001px) {
      .section-{{ section.id }}-block {
        background-image: url('{{ section.settings.image | image_url: width: 2000 }}');
          }
    }

    
    

  </style>

<style>
  
 @media screen and (max-width: 1599px) {
    .block5 .icon-section {
      width: 500px; } }
  
